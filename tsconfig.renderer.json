{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/renderer/**/*.js",
    "src/shared/types.d.ts"
  ]
}
