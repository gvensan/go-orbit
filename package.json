{
  "name": "orbit",
  "version": "0.2.0",
  "description": "Orbit - a local-first, encrypted relationship CRM that maps your people as a graph, served to your browser by a small Node service on your own machine.",
  "main": "src/server/server.js",
  "author": "Orbit",
  "repository": "https://github.com/gvensan/my-orbit.git",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node src/server/server.js",
    "predev": "npm run build:renderer",
    "dev": "node src/server/server.js",
    "dev:watch": "node scripts/dev-watch.js",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "verify:native": "node scripts/verify-native.js",
    "migrate": "node src/main/db/migrate.js .dev/contacts.db devkey",
    "migrate:ci": "node src/main/db/migrate.js ./ci.db cikey",
    "fixture": "node scripts/generate-fixture.js",
    "smoke:db": "node scripts/smoke-open-db.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-metrics": "2.4.0",
    "graphology-shortest-path": "2.1.0",
    "supercluster": "8.0.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/supercluster": "7.1.3",
    "sigma": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24.18 <25"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
