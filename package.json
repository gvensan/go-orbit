{
  "name": "orbit",
  "version": "0.1.0",
  "description": "Orbit - a local-first, encrypted desktop CRM that maps your people as a relationship graph, with you at the centre.",
  "main": "src/main/main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "predev": "npm run rebuild:electron && npm run build:renderer && node scripts/dev-brand-electron.js",
    "dev": "electron .",
    "predev:watch": "npm run rebuild:electron && npm run build:renderer && node scripts/dev-brand-electron.js",
    "brand:dev": "node scripts/dev-brand-electron.js",
    "dev:watch": "node scripts/dev-watch.js",
    "build:renderer": "vite build",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3-multiple-ciphers",
    "migrate": "node src/main/db/migrate.js .dev/contacts.db devkey",
    "migrate:ci": "node src/main/db/migrate.js ./ci.db cikey",
    "fixture": "node scripts/generate-fixture.js",
    "pretest": "npm run rebuild:node",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "prebuild": "npm run rebuild:electron && npm run build:renderer",
    "build": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.0.0",
    "electron-log": "^5.1.0",
    "electron-updater": "^6.2.0",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.3.1",
    "graphology-shortest-path": "^2.1.0",
    "supercluster": "^8.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/supercluster": "^7.1.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sigma": "^3.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
