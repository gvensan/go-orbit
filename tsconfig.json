{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main/**/*.js",
    "src/shared/*.js",
    "src/shared/types.d.ts",
    "scripts/*.js"
  ]
}
